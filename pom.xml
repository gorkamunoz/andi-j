<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.scijava</groupId>
        <artifactId>pom-scijava</artifactId>
        <version>36.0.0</version>
        <relativePath />
    </parent>

    <groupId>sc.fiji</groupId>
    <artifactId>andi-j</artifactId>
    <version>0.1.1</version>
    <packaging>jar</packaging>

    <name>AnDi-J</name>
    <description>Anomalous Diffusion trajectory analysis plugin for Fiji</description>
    <url>https://github.com/gorkamunoz/andi-j</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>AnDi-J</name>
        <url>https://github.com/gorkamunoz/andi-j</url>
    </organization>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit/</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>gorkamunoz</id>
            <name>Gorka Muñoz-Gil</name>
            <email>munoz.gil.gorka@gmail.com</email>
        </developer>
    </developers>

    <contributors>
        <contributor>
            <name>none</name>
        </contributor>
    </contributors>

    <mailingLists>
        <mailingList>
            <name>none</name>
        </mailingList>
    </mailingLists>

    <scm>
        <connection>scm:git:git://github.com/gorkamunoz/andi-j</connection>
        <developerConnection>scm:git:git@github.com:gorkamunoz/andi-j</developerConnection>
        <url>https://github.com/gorkamunoz/andi-j</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/gorkamunoz/andi-j/issues</url>
    </issueManagement>

    <ciManagement>
        <system>none</system>
    </ciManagement>

    <properties>
        <license.licenseName>mit</license.licenseName>
        <license.copyrightOwners>Gorka Muñoz-Gil</license.copyrightOwners>
        <!-- Target Java 8 for maximum Fiji compatibility -->
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- ImageJ1 core: IJ, Plot, GenericDialog, PlugIn, etc. -->
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ONNX Runtime – used for ML-based anomalous-exponent estimation -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime_gpu</artifactId>
            <version>1.26.0</version>
        </dependency>

        <!-- Batik SVG generator – exports the plots as vector SVG.
             "provided": Fiji already ships batik-*-1.17.jar in Fiji.app/jars,
             so nothing is added to our JAR and users need no extra download. -->
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-svggen</artifactId>
            <version>1.17</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-dom</artifactId>
            <version>1.17</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/groups/public</url>
        </repository>
    </repositories>
</project>
